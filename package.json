{
  "name": "xinecraft-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative world-state server for single-player integrated Minecraft viewers",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/src/main.js",
    "test": "npm run build && node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@fastify/websocket": "11.3.1",
    "fastify": "5.12.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.0",
    "@types/ws": "8.18.1",
    "jsdom": "30.1.1",
    "typescript": "5.9.3"
  }
}
